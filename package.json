    "chalk": "^5.0.0"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "keywords": [
    "openclaw",
    "nemoclaw",
    "teams",
    "microsoft-teams",
    "bot",
    "setup"
