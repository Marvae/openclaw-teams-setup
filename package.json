{
  "name": "openclaw-teams-setup",
  "version": "0.1.1",
  "type": "module",
  "description": "One-command Teams bot setup for OpenClaw and NemoClaw",
  "bin": {
    "openclaw-teams-setup": "./bin/cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:azure": "vitest run test/azure-integration.test.js",
    "test:azure:teardown": "node test/azure-integration-teardown.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
